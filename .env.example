# Copy to .env and fill in real values. Never commit the real .env -- see
# website/.gitignore. This file didn't exist in the original project, which
# is exactly how its real .env ended up committed to a git repo in the past;
# it exists now so that never happens again.

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# First admin login (change the password from the dashboard after first login)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Real public URL of this site, e.g. https://shariftechnologies.online
SITE_URL=

# Optional: Google AdSense client ID
ADSENSE_CLIENT_ID=

# SMTP (newsletter + contact form email). Without these, the site logs what
# would have been sent instead of actually sending it -- fine for testing.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
CONTACT_NOTIFY_EMAIL=

# Optional: enables the AI content module (Admin > AI)
GEMINI_API_KEY=

# Optional: caps contact-form image attachments, in bytes
MESSAGE_IMAGE_MAX_BYTES=

# Set by docker-compose.yml in this repo -- leave blank for a bare/PM2 install
PORT=
