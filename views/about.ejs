<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', {
    pageTitle: 'About',
    pageDescription: 'About ' + settings.site_name + ': ' + settings.about_html.replace(/<[^>]+>/g, '').trim().slice(0, 140),
    canonicalUrl: siteUrl + '/about'
  }) %>
</head>
<body>
  <%- include('partials/header') %>

  <section id="main">
    <div class="container" style="max-width:760px;">
      <span class="eyebrow"><%= t('about.eyebrow', 'Who we are') %></span>
      <h1><%= t('about.heading', 'About ' + settings.site_name) %></h1>
      <div class="trace"></div>
      <div class="settings-driven-content"><%- settings.about_html %></div>
    </div>
  </section>

  <section style="padding-top:0;">
    <div class="container">
      <span class="eyebrow"><%= t('about.services.eyebrow', 'What we build') %></span>
      <h2><%= t('about.services.heading', 'Services') %></h2>
      <div class="trace"></div>

      <% if (categories.length === 0) { %>
        <div class="empty-state"><p><%= t('home.services.empty', 'Services will be listed here soon.') %></p></div>
      <% } else { %>
        <div class="grid grid-3">
          <% categories.forEach(function(c) { %>
            <a href="/blog?category=<%= c.slug %>" class="card">
              <div class="content">
                <h3 style="font-size:1.1rem;"><%= c.name %></h3>
                <p class="excerpt"><%= t('home.services.card_cta', 'See related posts and updates →') %></p>
              </div>
            </a>
          <% }); %>
        </div>
      <% } %>
    </div>
  </section>

  <section style="padding-top:0;">
    <div class="container" style="max-width:760px;">
      <span class="eyebrow"><%= t('about.where.eyebrow', 'Where we operate') %></span>
      <h2><%= t('about.where.heading', 'Based in ' + settings.contact_location) %></h2>
      <div class="trace"></div>
      <p class="muted"><%= t('about.where.body', settings.site_name + ' is based in ' + settings.contact_location + ' and works with businesses and individuals across Ghana.') %></p>
    </div>
  </section>

  <section style="padding-top:0;border-top:1px solid var(--line);">
    <div class="container text-center" style="max-width:600px;padding-top:40px;">
      <span class="eyebrow"><%= t('about.next.eyebrow', 'Learn more') %></span>
      <h2><%= t('about.next.heading', "What's next") %></h2>
      <div class="trace" style="margin-left:auto;margin-right:auto;"></div>
      <p class="muted"><%= t('about.next.body', 'Read our latest insights, or reach out directly.') %></p>
      <div class="cta-row" style="justify-content:center;">
        <a href="/blog" class="btn btn-outline"><%= t('about.next.blog_cta', 'Read the blog') %></a>
        <a href="/connect" class="btn btn-primary"><%= t('about.next.connect_cta', 'Connect with us') %></a>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
