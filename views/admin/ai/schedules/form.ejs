<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>New Schedule — SharifTech Admin</title>
  <link rel="stylesheet" href="/static/css/main.css">
  <link rel="stylesheet" href="/static/css/admin.css">
</head>
<body>
  <div class="admin-shell">
    <%- include('../../partials/sidebar') %>
    <main class="admin-main">
      <div class="admin-topbar"><h1>New Schedule</h1></div>
      <div class="admin-content form-panel-width">

        <% if (templates.length === 0) { %>
          <div class="empty-state">
            <div class="icon">📋</div>
            <p>You need at least one active prompt template before creating a schedule. <a href="/admin/ai/prompts/new">Create one first</a>.</p>
          </div>
        <% } else { %>

          <form method="POST" action="/admin/ai/schedules">
            <div class="panel">
              <div class="field">
                <label>Schedule name</label>
                <input type="text" name="name" required placeholder="e.g. Weekly cybersecurity article">
              </div>

              <div class="field">
                <label>Prompt template</label>
                <select name="prompt_template_id" id="templateSelect" required>
                  <option value="">Choose...</option>
                  <% templates.forEach(function(t) { %>
                    <option value="<%= t.id %>" data-content-type="<%= t.content_type %>"><%= t.content_type %> — <%= t.name %></option>
                  <% }); %>
                </select>
              </div>
              <input type="hidden" name="content_type" id="contentTypeHidden">

              <div class="field">
                <label>Schedule <span class="muted">(cron format: minute hour day month weekday)</span></label>
                <input type="text" name="schedule_cron" required placeholder="0 8 * * 1" value="0 8 * * 1">
                <div class="hint">
                  Examples: <code>0 8 * * 1</code> = every Monday at 8am &middot;
                  <code>0 9 * * *</code> = every day at 9am &middot;
                  <code>0 8 1 * *</code> = first of every month at 8am.
                  Supports <code>*</code>, exact numbers, comma lists (<code>1,3,5</code>), and step values (<code>*/15</code>) — not range syntax like <code>1-5</code>.
                </div>
              </div>

              <div class="field" id="autoPublishField">
                <label style="display:flex;align-items:center;gap:8px;font-weight:normal;">
                  <input type="checkbox" name="auto_publish" value="1" style="width:auto;">
                  Publish automatically, with no review
                </label>
                <div class="hint" style="color:#a32c2c;">
                  Only applies to blog posts. The post goes live on the site the moment it's generated — nobody checks it first. Leave this unchecked to get a draft you review and publish yourself instead.
                </div>
              </div>
            </div>

            <button type="submit" class="btn btn-primary">Create Schedule</button>
            <a href="/admin/ai/schedules" class="btn btn-outline">Cancel</a>
          </form>

        <% } %>

      </div>
    </main>
  </div>

  <script>
    const templateSelect = document.getElementById('templateSelect');
    const contentTypeHidden = document.getElementById('contentTypeHidden');
    const autoPublishField = document.getElementById('autoPublishField');

    function syncAutoPublishVisibility() {
      const isBlogPost = contentTypeHidden.value === 'blog_post';
      autoPublishField.style.display = isBlogPost ? '' : 'none';
      if (!isBlogPost) autoPublishField.querySelector('input[type=checkbox]').checked = false;
    }

    if (templateSelect) {
      templateSelect.addEventListener('change', function() {
        const opt = templateSelect.options[templateSelect.selectedIndex];
        contentTypeHidden.value = opt.dataset.contentType || '';
        syncAutoPublishVisibility();
      });
    }
    syncAutoPublishVisibility();
  </script>
</body>
</html>
