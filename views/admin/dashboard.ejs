<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard — SharifTech Admin</title>
  <link rel="stylesheet" href="/static/css/main.css">
  <link rel="stylesheet" href="/static/css/admin.css">
</head>
<body>
  <div class="admin-shell">
    <%- include('partials/sidebar') %>
    <main class="admin-main">
      <div class="admin-topbar"><h1>Dashboard</h1></div>
      <div class="admin-content">

        <div class="stat-grid">
          <div class="stat-card"><div class="num"><%= stats.posts %></div><div class="label">Total Posts</div></div>
          <div class="stat-card"><div class="num"><%= stats.published %></div><div class="label">Published</div></div>
          <div class="stat-card"><div class="num"><%= stats.subscribers %></div><div class="label">Confirmed Subscribers</div></div>
          <div class="stat-card"><div class="num"><%= stats.newMessages %></div><div class="label">New Messages</div></div>
        </div>

        <div class="panel">
          <div class="row-between" style="margin-bottom:16px;">
            <h2 style="margin:0;">Recent Posts</h2>
            <a href="/admin/posts/new" class="btn btn-primary btn-sm">+ New Post</a>
          </div>
          <% if (recentPosts.length === 0) { %>
            <p class="muted">No posts yet — create your first one.</p>
          <% } else { %>
            <div class="thumb-list">
              <% recentPosts.forEach(function(p) { %>
                <div class="thumb-row">
                  <div class="thumb-sq">📝</div>
                  <div>
                    <div class="title"><%= p.title %></div>
                    <div class="sub"><span class="pill pill-<%= p.status %>"><%= p.status %></span></div>
                  </div>
                  <div class="actions">
                    <a href="/admin/posts/<%= p.id %>/edit" class="btn btn-outline btn-sm">Edit</a>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } %>
        </div>

        <div class="panel">
          <div class="row-between" style="margin-bottom:16px;">
            <h2 style="margin:0;">Recent Messages</h2>
            <a href="/admin/messages" class="btn btn-outline btn-sm">View inbox</a>
          </div>
          <% if (recentMessages.length === 0) { %>
            <p class="muted">No messages yet.</p>
          <% } else { %>
            <div class="thumb-list">
              <% recentMessages.forEach(function(m) { %>
                <a href="/admin/messages/<%= m.id %>" class="thumb-row" style="text-decoration:none;color:inherit;">
                  <div class="thumb-sq"><%= m.status === 'new' ? '🔵' : '✉️' %></div>
                  <div>
                    <div class="title"><%= m.subject || '(no subject)' %></div>
                    <div class="sub">from <%= m.name %> &middot; <%= new Date(m.created_at).toLocaleDateString() %></div>
                  </div>
                  <div class="actions"><span class="pill pill-<%= m.status === 'new' ? 'pending' : 'published' %>"><%= m.status %></span></div>
                </a>
              <% }); %>
            </div>
          <% } %>
        </div>

      </div>
    </main>
  </div>
</body>
</html>
