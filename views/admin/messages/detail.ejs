<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= message.subject || 'Message' %> — SharifTech Admin</title>
  <link rel="stylesheet" href="/static/css/main.css">
  <link rel="stylesheet" href="/static/css/admin.css">
</head>
<body>
  <div class="admin-shell">
    <%- include('../partials/sidebar', { active: 'messages' }) %>
    <main class="admin-main">
      <div class="admin-topbar">
        <h1><%= message.subject || '(no subject)' %></h1>
        <a href="/admin/messages" class="btn btn-outline btn-sm">&larr; Back to inbox</a>
      </div>
      <div class="admin-content form-panel-width">

        <div class="panel">
          <div class="row-between" style="margin-bottom:16px;">
            <div>
              <div style="font-weight:700;"><%= message.name %></div>
              <div class="muted" style="font-size:0.88rem;"><%= message.email %></div>
            </div>
            <span class="pill pill-<%= message.status === 'new' ? 'pending' : (message.status === 'archived' ? 'draft' : 'published') %>"><%= message.status %></span>
          </div>
          <div class="muted" style="font-size:0.82rem;margin-bottom:16px;">Received <%= new Date(message.created_at).toLocaleString() %></div>

          <div style="white-space:pre-wrap;line-height:1.7;padding:16px;background:#f7f9fc;border-radius:10px;"><%= message.body %></div>

          <% if (message.attachment_path) { %>
            <div style="margin-top:16px;">
              <div class="muted" style="font-size:0.82rem;margin-bottom:8px;">Attachment:</div>
              <a href="/uploads/messages/<%= message.attachment_path %>" target="_blank">
                <img src="/uploads/messages/<%= message.attachment_path %>" style="max-width:100%;max-height:400px;border-radius:10px;border:1px solid var(--line);">
              </a>
            </div>
          <% } %>

          <div style="margin-top:20px;">
            <a href="mailto:<%= message.email %>?subject=Re: <%= message.subject || 'Your message to SharifTech' %>" class="btn btn-primary">Reply by Email</a>
          </div>
        </div>

        <div class="panel">
          <h2>Update status</h2>
          <form method="POST" action="/admin/messages/<%= message.id %>/status" style="display:flex;gap:10px;flex-wrap:wrap;">
            <select name="status">
              <option value="new" <%= message.status === 'new' ? 'selected' : '' %>>New</option>
              <option value="read" <%= message.status === 'read' ? 'selected' : '' %>>Read</option>
              <option value="replied" <%= message.status === 'replied' ? 'selected' : '' %>>Replied</option>
              <option value="archived" <%= message.status === 'archived' ? 'selected' : '' %>>Archived</option>
            </select>
            <button class="btn btn-outline">Update</button>
          </form>
        </div>

        <form method="POST" action="/admin/messages/<%= message.id %>/delete" onsubmit="return confirm('Delete this message permanently?');">
          <button class="btn btn-danger btn-sm">Delete Message</button>
        </form>

      </div>
    </main>
  </div>
</body>
</html>
