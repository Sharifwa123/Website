<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login — SharifTech</title>
  <link rel="stylesheet" href="/static/css/main.css">
  <link rel="stylesheet" href="/static/css/admin.css">
</head>
<body>
  <div class="login-shell">
    <div class="login-card">
      <div class="brand-mini">
        <img src="<%= settings && settings.logo_path ? '/uploads/' + settings.logo_path : '/static/images/logo.png' %>" alt="logo">
        <span style="font-family:var(--heading-font);font-weight:600;font-size:1.2rem;color:var(--ink);">SharifTech Admin</span>
      </div>
      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <form method="POST" action="/admin/login">
        <div class="field">
          <label>Email</label>
          <input type="email" name="email" required autofocus>
        </div>
        <div class="field">
          <label>Password</label>
          <input type="password" name="password" required>
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;">Log In</button>
      </form>
    </div>
  </div>
</body>
</html>
