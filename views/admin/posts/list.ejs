<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Blog Posts — SharifTech Admin</title>
  <link rel="stylesheet" href="/static/css/main.css">
  <link rel="stylesheet" href="/static/css/admin.css">
</head>
<body>
  <div class="admin-shell">
    <%- include('../partials/sidebar') %>
    <main class="admin-main">
      <div class="admin-topbar">
        <h1>Blog Posts</h1>
        <a href="/admin/posts/new" class="btn btn-primary">+ New Post</a>
      </div>
      <div class="admin-content">
        <% if (posts.length === 0) { %>
          <div class="empty-state">
            <div class="icon">📝</div>
            <p>No posts yet.</p>
            <a href="/admin/posts/new" class="btn btn-primary" style="margin-top:12px;">Write your first post</a>
          </div>
        <% } else { %>
          <table>
            <thead><tr><th>Title</th><th>Category</th><th>Status</th><th>Views</th><th>Updated</th><th></th></tr></thead>
            <tbody>
              <% posts.forEach(function(p) { %>
                <tr>
                  <td>
                    <strong><%= p.title %></strong>
                    <% if (p.source === 'ai_generated') { %>
                      <span class="pill" style="background:#eaf0ff;color:#123a8f;font-size:0.7rem;margin-left:6px;" title="Generated by AI -- review before publishing if it's still a draft">🤖 AI</span>
                    <% } %>
                  </td>
                  <td><%= p.category_name || '—' %></td>
                  <td><span class="pill pill-<%= p.status %>"><%= p.status %></span></td>
                  <td><%= p.views %></td>
                  <td class="muted"><%= new Date(p.updated_at).toLocaleDateString() %></td>
                  <td>
                    <div style="display:flex;gap:8px;">
                      <a href="/admin/posts/<%= p.id %>/edit" class="btn btn-outline btn-sm">Edit</a>
                      <form method="POST" action="/admin/posts/<%= p.id %>/delete" onsubmit="return confirm('Delete this post permanently?');">
                        <button class="btn btn-danger btn-sm">Delete</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        <% } %>
      </div>
    </main>
  </div>
</body>
</html>
