<!DOCTYPE html>
<html lang="en">
<head>
  <%
    const postDescription = (post.excerpt && post.excerpt.trim())
      ? post.excerpt
      : post.body_html.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 160);
    const postUrl = siteUrl + '/blog/' + post.slug;
    const postImage = post.cover_image ? siteUrl + '/uploads/' + post.cover_image : undefined;
    // SQLite's datetime('now') stores "YYYY-MM-DD HH:MM:SS" (UTC, no offset marker) --
    // appending " UTC" is what makes JS's Date parser read it as UTC instead of
    // silently treating it as local time, so structured data gets a correct ISO 8601 value.
    const toIso = function(sqliteDatetime) {
      if (!sqliteDatetime) return undefined;
      const d = new Date(sqliteDatetime + ' UTC');
      return isNaN(d.getTime()) ? undefined : d.toISOString();
    };
    const isoPublished = toIso(post.published_at);
    const isoModified = toIso(post.updated_at) || isoPublished;
  %>
  <%- include('partials/head', {
    pageTitle: post.title,
    pageDescription: postDescription,
    canonicalUrl: postUrl,
    pageOgType: 'article',
    pageImage: postImage
  }) %>
  <script type="application/ld+json">
  <%- JSON.stringify(Object.assign({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": post.title,
    "description": postDescription,
    "datePublished": isoPublished,
    "dateModified": isoModified,
    "url": postUrl,
    "mainEntityOfPage": postUrl,
    "author": { "@type": "Organization", "name": settings.site_name },
    "publisher": { "@type": "Organization", "name": settings.site_name, "logo": { "@type": "ImageObject", "url": siteUrl + (settings.logo_path ? '/uploads/' + settings.logo_path : '/static/images/logo.png') } }
  }, postImage ? { "image": postImage } : {})) %>
  </script>
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl + "/" },
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": siteUrl + "/blog" },
      { "@type": "ListItem", "position": 3, "name": post.title, "item": postUrl }
    ]
  }) %>
  </script>
</head>
<body>
  <%- include('partials/header') %>

  <article id="main">
    <div class="container" style="max-width:760px;padding-top:40px;">
      <nav aria-label="Breadcrumb" class="breadcrumb-trail muted" style="font-size:0.85rem;">
        <a href="/">Home</a><span class="chevron" aria-hidden="true">&rsaquo;</span><a href="/blog"><%= t('home.blogtab.heading', 'Blog') %></a><span class="chevron" aria-hidden="true">&rsaquo;</span><span><%= post.title %></span>
      </nav>
      <a href="/blog" class="muted" style="font-size:0.9rem;"><%= t('post.back_link', '← Back to blog') %></a>
      <% if (post.category_name) { %><div style="margin-top:16px;"><span class="cat-tag"><%= post.category_name %></span></div><% } %>
      <h1 style="margin-top:12px;"><%= post.title %></h1>
      <div class="meta muted" style="margin-bottom:24px;">
        <span><%= new Date(post.published_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
        &nbsp;·&nbsp; <span><%= post.views %> <%= t('post.views_suffix', 'views') %></span>
      </div>

      <% if (post.cover_image) { %>
        <img src="/uploads/<%= post.cover_image %>" alt="<%= post.title %>" style="border-radius:14px;margin-bottom:28px;">
      <% } %>

      <div class="post-body"><%- post.body_html %></div>

      <%- include('partials/ad-slot', { slot: settings.adsense_slot_in_article }) %>
    </div>
  </article>

  <% if (relatedPosts.length) { %>
  <section>
    <div class="container">
      <h2 style="font-size:1.3rem;"><%= t('post.related_heading', 'More like this') %></h2>
      <div class="trace"></div>
      <div class="grid grid-3">
        <% relatedPosts.forEach(function(p) { %>
          <a href="/blog/<%= p.slug %>" class="card">
            <% if (p.cover_image) { %><img class="thumb" src="/uploads/<%= p.cover_image %>" alt=""><% } %>
            <div class="content">
              <h3 style="font-size:1rem;"><%= p.title %></h3>
              <p class="excerpt"><%= p.excerpt %></p>
            </div>
          </a>
        <% }); %>
      </div>
    </div>
  </section>
  <% } %>

  <%- include('partials/footer') %>
</body>
</html>
